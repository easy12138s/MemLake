# ========== 数据库 ==========
DATABASE_URL=postgresql+psycopg://memlake:memlake@localhost:5432/memlake
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ========== MCP 网关 ==========
MCP_SERVER_NAME=mem-lake
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_RATE_LIMIT_QPS=100

# ========== Embedding 服务 ==========
EMBEDDING_MODEL_PATH=./models/bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# ========== AGE 图 ==========
AGE_GRAPH_NAME=mem_lake_graph

# ========== 安全 ==========
# bcrypt 轮数
BCRYPT_ROUNDS=12
# 审批超期阈值（天）
APPROVAL_WARNING_DAYS=7
APPROVAL_TIMEOUT_DAYS=30
# 冲突检测相似度阈值
CONFLICT_SIMILARITY_THRESHOLD=0.85
