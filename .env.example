# ========== 数据库 ==========
# Compose 部署下 POSTGRES_* 变量贯穿 postgres 容器与 mem-lake 的 DATABASE_URL
#（修改 .env 中密码即真实生效；容器网络内 app 一律连 postgres 主机名，无需改 URL）
POSTGRES_USER=memlake
POSTGRES_PASSWORD=memlake
POSTGRES_DB=memlake
# 本地直连场景（非 Compose）才需要手改此 URL
DATABASE_URL=postgresql+psycopg_async://memlake:memlake@localhost:5432/memlake
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ========== MCP 网关 ==========
MCP_SERVER_NAME=mem-lake
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_RATE_LIMIT_QPS=100
# Agent 实际可达的 MCP 地址（远程部署改为公网/网关地址，本地默认即可）
MCP_PUBLIC_URL=http://localhost:8000/mcp

# ========== Embedding 服务 ==========
# TORCH_CUDA：构建 embedding 镜像时 torch 类型。false=cpu(默认，镜像小，无 CUDA)；true=cuda(镜像大，需 GPU)
TORCH_CUDA=false
# EMBEDDING_DEVICE：推理设备。默认 cpu；若 TORCH_CUDA=true 且本机有 GPU，改为 cuda
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024
EMBEDDING_HOST=localhost
EMBEDDING_PORT=8001

# ========== Rerank 精排 ==========
# bge-reranker-base（CrossEncoder）路径。留空=不启用精排，检索退回 RRF 原序。
RERANK_MODEL_PATH=
# 精排候选数（RRF 融合后取前 N 个精排），越小延迟越低
RERANK_TOP_K=30
# 总开关：配合 RERANK_MODEL_PATH 非空才真正启用
ENABLE_RERANK=true

# ========== AGE 图 ==========
AGE_GRAPH_NAME=mem_lake_graph

# ========== 安全 ==========
# bcrypt 轮数
BCRYPT_ROUNDS=12
# 审批超期阈值（天）
APPROVAL_WARNING_DAYS=7
APPROVAL_TIMEOUT_DAYS=30
# 冲突检测相似度阈值（初始预设 0.85；部署沉淀数据后请用 scripts/calibrate_conflict_threshold.py 重标）
CONFLICT_SIMILARITY_THRESHOLD=0.85

# ========== 宽松模式（免审批直接入库）==========
# 全局主开关：false 时即便某个 Access Key 标记为宽松（lax_mode=true）也强制走审批（紧急熔断）
LAX_MODE_ENABLED=true

# ========== 可观测性 ==========
# 是否挂载 mem-lake 网关 /metrics（Prometheus 拉取，面向内网默认不加鉴权）
OBS_METRICS_ENABLED=true
# 结构化日志格式：console（可读文本）/ json（单行 JSON，生产推荐）
OBS_LOG_FORMAT=console
