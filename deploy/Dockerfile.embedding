# Embedding 服务镜像
# 基于 Python slim，内置 sentence-transformers + bge-large-zh-v1.5 模型
FROM python:3.11-slim

# 使用清华 PyPI 镜像加速（模型在运行时从宿主机挂载，不在构建期下载）
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    && pip install --no-cache-dir \
    sentence-transformers>=3.0.0 \
    fastapi>=0.115.0 \
    uvicorn[standard]>=0.30.0

WORKDIR /app
COPY embedding_server.py /app/

ENV MODEL_PATH=/models/bge-large-zh-v1.5

EXPOSE 8001
CMD ["uvicorn", "embedding_server:app", "--host", "0.0.0.0", "--port", "8001"]
